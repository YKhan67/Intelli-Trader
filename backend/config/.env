# Backend API Cluster Settings
API_PORT=8081
API_HOST=0.0.0.0

# Database Settings (Institutional 127.0.0.1 Fix)
# Note: Use IPv4 127.0.0.1 to avoid WSL/Windows localhost relay conflicts.
