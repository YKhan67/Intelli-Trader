MONGODB_URL=mongodb://127.0.0.1:27017/forexai
REDIS_URL=redis://127.0.0.1:6379/0

# Security (Internal Cluster Auth)
FOREXAI_API_KEY=dev_key
SECRET_KEY=institutional_secret_grid_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NLP & Machine Learning Settings
# Local FinBERT for sentiment analysis (No external API needed)
FINBERT_MODEL_PATH=./models/finbert/

# Data Ingestion (Institutional Free Sources)
# Price: Dukascopy (via node) & GitHub Archives
# Calendar: Institutional Web Scraping
# News: RSS & GDELT Project
